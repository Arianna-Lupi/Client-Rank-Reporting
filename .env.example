# =============================================================================
# Client Rank Reporting — environment variable inventory (SCH-03)
# Copy this file to .env.local and fill in REAL values. NEVER commit .env.local.
# =============================================================================

# Slack signing secret used to verify the HMAC of incoming slash-command
# requests over the raw request body (CMD-05).
# Source: api.slack.com/apps -> your App -> Basic Information -> App Credentials
#         -> Signing Secret
SLACK_SIGNING_SECRET=

# Destination Slack channel id for the daily report (single channel, v1).
# Consumed by the report in Phase 4; documented now per SCH-03.
# Source: Slack -> target channel -> Copy link -> id that starts with "C..."
SLACK_CHANNEL_ID=

# Google Search Console Service Account credential: the FULL Service Account
# JSON key file, base64-encoded as a single string (GSC-01). Avoids the
# escaped-newline private-key bug. NEVER store the raw JSON or split the
# private key into a separate variable.
# Source: GCP -> IAM -> Service Accounts -> Keys -> create JSON key, then:
#         macOS:  base64 -i key.json | tr -d '\n'
GSC_SA_KEY_B64=

# OPTIONAL. Google Workspace user email the Service Account impersonates via
# domain-wide delegation. Set this when the target GSC properties CANNOT be
# shared with the SA directly but a Workspace user already has access to them.
# Requires the SA's client_id + the webmasters.readonly scope to be authorized
# in Workspace Admin -> Security -> API controls -> Domain-Wide Delegation.
# When unset, the bot uses plain Service Account auth (only sees properties
# shared with the SA email).
GSC_IMPERSONATE_SUBJECT=

# Upstash Redis REST endpoint for persisting the active-client list (PER-01).
# Read automatically by Redis.fromEnv() from @upstash/redis.
# Source: console.upstash.com -> your database -> REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# IANA timezone for the daily report schedule. Optional; defaults to
# America/Mexico_City when unset. Consumed by the cron in Phase 4 (SCH-03).
REPORT_TZ=America/Mexico_City

# Slack bot token (xoxb-…) with the chat:write scope, used for the PROACTIVE
# daily report posts (RPT-03). This is NOT the signing secret: proactive
# chat.postMessage calls require a bot token, not the request-verification
# secret. Required for the cron to post.
# Source: api.slack.com/apps -> your App -> OAuth & Permissions -> Bot User
#         OAuth Token (starts with "xoxb-")
SLACK_BOT_TOKEN=

# Shared secret that Vercel Cron automatically injects as
# `Authorization: Bearer <CRON_SECRET>` into every cron invocation (SCH-02).
# The cron endpoint rejects any request without this exact value, so external
# callers cannot trigger the report. Use any long random string.
# Source: generate locally (e.g. `openssl rand -hex 32`) and set it in the
#         Vercel project env so Vercel forwards it to the cron.
CRON_SECRET=

# Local hour (0-23) in REPORT_TZ at which the daily report fires (SCH-01).
# Optional; defaults to 9 when unset or invalid. The hourly Vercel cron no-ops
# every other hour and only posts when the local hour equals this value.
REPORT_HOUR=9
