# =============================================================================
# Client Rank Reporting — environment variable inventory (SCH-03)
# Copy this file to .env.local and fill in REAL values. NEVER commit .env.local.
# =============================================================================

# Slack signing secret used to verify the HMAC of incoming slash-command
# requests over the raw request body (CMD-05).
# Source: api.slack.com/apps -> your App -> Basic Information -> App Credentials
#         -> Signing Secret
SLACK_SIGNING_SECRET=

# Destination Slack channel id for the daily report (single channel, v1).
# Consumed by the report in Phase 4; documented now per SCH-03.
# Source: Slack -> target channel -> Copy link -> id that starts with "C..."
SLACK_CHANNEL_ID=

# Google Search Console Service Account credential: the FULL Service Account
# JSON key file, base64-encoded as a single string (GSC-01). Avoids the
# escaped-newline private-key bug. NEVER store the raw JSON or split the
# private key into a separate variable.
# Source: GCP -> IAM -> Service Accounts -> Keys -> create JSON key, then:
#         macOS:  base64 -i key.json | tr -d '\n'
GSC_SA_KEY_B64=

# Upstash Redis REST endpoint for persisting the active-client list (PER-01).
# Read automatically by Redis.fromEnv() from @upstash/redis.
# Source: console.upstash.com -> your database -> REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# IANA timezone for the daily report schedule. Optional; defaults to
# America/Mexico_City when unset. Consumed by the cron in Phase 4 (SCH-03).
REPORT_TZ=America/Mexico_City
